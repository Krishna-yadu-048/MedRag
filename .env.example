ACTIVE_PROJECT=medrag
OPENAI_API_KEY=
LLAMA_CLOUD_API_KEY=
GROQ_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_OUTPUT_DIMENSIONALITY=384
EMBEDDING_BATCH_SIZE=16
MAX_GUIDELINE_FILES=3
PUBMED_ENABLED=true
PUBMED_QUERY_LIMIT=1
PUBMED_MAX_RESULTS=5
CHUNK_SIZE=256
CHUNK_OVERLAP=32
# Retrieve SIMILARITY_TOP_K candidates, then a cross-encoder keeps the best RERANK_TOP_N.
# Set RERANK_MODEL empty to disable reranking (RELATIVE_SCORE_CUTOFF then applies if > 0).
SIMILARITY_TOP_K=8
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=2
RELATIVE_SCORE_CUTOFF=0
# LlamaParse v2 tier: fast, cost_effective, agentic or agentic_plus
LLAMA_PARSE_TIER=cost_effective
# "default" (dense only) or "hybrid" (dense + BM25 sparse). Reindex after switching.
VECTOR_STORE_QUERY_MODE=default
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_TOP_K=8
HYBRID_ALPHA=0.5
API_BASE_URL=http://localhost:8000
